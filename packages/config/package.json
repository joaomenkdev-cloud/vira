{
  "name": "@vira/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint, Prettier and Vitest configuration for the Vira workspace",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./vitest": "./vitest/index.js"
  },
  "files": [
    "eslint",
    "tsconfig",
    "vitest"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
