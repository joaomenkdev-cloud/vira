{
  "name": "@vira/api",
  "version": "0.0.0",
  "private": true,
  "description": "Vira HTTP API and background worker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --env-file .env",
    "start": "node dist/main.js",
    "lint": "eslint . && depcruise src test --config .dependency-cruiser.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "dev:worker": "nest start --watch --entryFile main.worker --env-file .env",
    "start:worker": "node dist/main.worker.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vira/shared": "workspace:^",
    "bullmq": "^6.3.11",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12",
    "@nestjs/testing": "^12.1.2",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vira/config": "workspace:^",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
