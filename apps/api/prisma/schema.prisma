// Vira database schema. Reference design: docs/DATA_MODEL.md.
// Invariants Prisma cannot express (CHECK constraints, partial indexes, triggers,
// extensions) live as SQL in the migrations (ADR-0004).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Append-only record of sensitive actions (docs/DATA_MODEL.md#audit_logs).
/// UPDATE, DELETE and TRUNCATE are rejected by a trigger; see the migration.
model AuditLog {
  id         String   @id @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  /// Pseudonymous: stays valid after the user is anonymized. NULL for the system.
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  requestId  String?  @map("request_id")
  /// Validated per action; never holds personal data.
  metadata   Json     @default("{}") @db.JsonB

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

/// Transactional outbox: side effects (queue jobs) are recorded in the same
/// transaction as the state change that causes them, then dispatched afterwards
/// (docs/ARCHITECTURE.md#6-mensageria-e-jobs).
model OutboxMessage {
  id           String    @id @db.Uuid
  /// "<area>.<event>", e.g. "orders.paid"; each type routes to one queue.
  type         String
  /// Identifiers only, never personal data.
  payload      Json      @db.JsonB
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  /// Earliest time of the next dispatch attempt (exponential backoff on failure).
  availableAt  DateTime  @map("available_at") @db.Timestamptz(3)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")

  @@index([dispatchedAt, availableAt, createdAt])
  @@map("outbox_messages")
}

enum Role {
  BUYER
  ORGANIZER
  ADMIN

  @@map("role")
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE

  @@map("token_purpose")
}

/// Accounts (docs/DATA_MODEL.md#users). Personal data: email, name and password_hash.
model User {
  id               String    @id @db.Uuid
  /// Normalized (trimmed, lower case); `citext` makes the unique index case-insensitive.
  email            String    @unique @db.Citext
  name             String
  /// argon2id PHC string; NULL for accounts that only use social login.
  passwordHash     String?   @map("password_hash")
  /// Never taken from a request body: new accounts are BUYER.
  role             Role      @default(BUYER)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Consecutive failed password logins; reset by a successful login.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  /// While in the future, password logins are refused (progressive lockout).
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  anonymizedAt     DateTime? @map("anonymized_at") @db.Timestamptz(3)
  /// New address waiting for the link sent to it (e-mail change); replaces `email` once used.
  pendingEmail     String?   @map("pending_email") @db.Citext

  verificationTokens VerificationToken[]
  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  organizerProfile   OrganizerProfile?
  orders             Order[]
  checkedInTickets   Ticket[]

  @@map("users")
}

/// Single-use tokens for e-mail verification, password reset and e-mail change
/// (docs/DATA_MODEL.md#verification_tokens). Only the SHA-256 hash is stored:
/// the token itself exists only in the e-mail that carries it.
model VerificationToken {
  id        String       @id @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash Bytes        @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @map("created_at") @db.Timestamptz(3)
  /// EMAIL_CHANGE only: the address the link was sent to, the only one it can confirm.
  newEmail  String?      @map("new_email") @db.Citext

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

enum SessionRevokeReason {
  LOGOUT
  REUSE_DETECTED
  PASSWORD_CHANGED
  ACCOUNT_DELETED

  @@map("session_revoke_reason")
}

/// Refresh tokens (docs/DATA_MODEL.md#sessions, ADR-0005). One row per token; the
/// rotations of one login share `familyId`, which is the session id of the access token.
/// Only the SHA-256 hash is stored: the token itself exists only in the cookie.
model Session {
  id                String               @id @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  familyId          String               @map("family_id") @db.Uuid
  tokenHash         Bytes                @unique @map("token_hash")
  /// When the person logged in; the same for every rotation of the family.
  authenticatedAt   DateTime             @map("authenticated_at") @db.Timestamptz(3)
  createdAt         DateTime             @map("created_at") @db.Timestamptz(3)
  /// 30 days after the login; the same for every rotation of the family.
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.Timestamptz(3)
  /// 7 days of inactivity, capped by `absoluteExpiresAt`.
  expiresAt         DateTime             @map("expires_at") @db.Timestamptz(3)
  rotatedAt         DateTime?            @map("rotated_at") @db.Timestamptz(3)
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokeReason      SessionRevokeReason? @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

enum OAuthProvider {
  GOOGLE
  GITHUB

  @@map("oauth_provider")
}

/// Social login links (docs/DATA_MODEL.md#oauth_accounts): which provider account
/// belongs to which user. No provider token is ever stored, only the account id.
model OAuthAccount {
  id                String        @id @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  /// Google's `sub` or GitHub's numeric user id. Personal data (an identifier).
  providerAccountId String        @map("provider_account_id")
  createdAt         DateTime      @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Public identity of an organizer (docs/DATA_MODEL.md#organizer_profiles): at most one
/// per user. Personal data when the organizer is a person (`displayName`).
model OrganizerProfile {
  id          String   @id @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  /// Derived from the display name; unique, used in public URLs.
  slug        String   @unique
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       Event[]
  mediaUploads MediaUpload[]

  @@map("organizer_profiles")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELED

  @@map("event_status")
}

/// Events (docs/DATA_MODEL.md#events). Ended is derived (`endsAt < now`), not a status.
/// Completeness of published events, the venue's four parts and the timestamps of each
/// status are CHECKs in the migration.
model Event {
  id                String      @id @db.Uuid
  organizerId       String      @map("organizer_id") @db.Uuid
  slug              String      @unique
  title             String
  descriptionMd     String      @default("") @map("description_md")
  /// Sanitized HTML rendered by the API from `descriptionMd`; never taken from a client.
  descriptionHtml   String      @default("") @map("description_html")
  status            EventStatus @default(DRAFT)
  startsAt          DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime    @map("ends_at") @db.Timestamptz(3)
  /// IANA zone, for display.
  timezone          String
  venueName         String?     @map("venue_name")
  venueAddress      String?     @map("venue_address")
  venueCity         String?     @map("venue_city")
  venueState        String?     @map("venue_state") @db.Char(2)
  imageKey          String?     @map("image_key")
  imageAlt          String?     @map("image_alt")
  imageWidth        Int?        @map("image_width")
  imageHeight       Int?        @map("image_height")
  /// Tiny blurred WebP preview (data URL), made by the upload.
  imageBlurDataUrl  String?     @map("image_blur_data_url")
  imageCreditAuthor String?     @map("image_credit_author")
  imageCreditUrl    String?     @map("image_credit_url")
  imageLicense      String?     @map("image_license")
  isDemo            Boolean     @default(false) @map("is_demo")
  publishedAt       DateTime?   @map("published_at") @db.Timestamptz(3)
  canceledAt        DateTime?   @map("canceled_at") @db.Timestamptz(3)
  cancelReason      String?     @map("cancel_reason")
  createdAt         DateTime    @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizer    OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  ticketTypes  TicketType[]
  mediaUploads MediaUpload[]
  orders       Order[]
  tickets      Ticket[]

  @@index([organizerId, createdAt])
  @@index([status, startsAt])
  @@map("events")
}

/// What an event sells (docs/DATA_MODEL.md#ticket_types). `sold + reserved <= capacity`
/// is a CHECK: the database refuses overbooking even if the API has a bug (ADR-0007).
model TicketType {
  id           String    @id @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  name         String
  description  String?
  priceCents   Int       @map("price_cents")
  currency     String    @default("BRL") @db.Char(3)
  capacity     Int
  sold         Int       @default(0)
  reserved     Int       @default(0)
  maxPerOrder  Int       @default(10) @map("max_per_order")
  salesStartAt DateTime? @map("sales_start_at") @db.Timestamptz(3)
  salesEndAt   DateTime? @map("sales_end_at") @db.Timestamptz(3)
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@index([eventId, sortOrder])
  @@map("ticket_types")
}

enum UploadStatus {
  PENDING
  CONFIRMED
  REJECTED

  @@map("upload_status")
}

/// Uploads of event pictures (docs/DATA_MODEL.md#media_uploads): the original the browser
/// sends (`objectKey`) and, once confirmed, the re-encoded picture (`imageKey`). Key
/// formats, types, sizes and the confirmed state are CHECKs in the migration.
model MediaUpload {
  id          String       @id @db.Uuid
  ownerId     String       @map("owner_id") @db.Uuid
  eventId     String?      @map("event_id") @db.Uuid
  objectKey   String       @unique @map("object_key")
  contentType String       @map("content_type")
  sizeBytes   Int          @map("size_bytes")
  status      UploadStatus @default(PENDING)
  imageKey    String?      @unique @map("image_key")
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime     @map("created_at") @db.Timestamptz(3)
  confirmedAt DateTime?    @map("confirmed_at") @db.Timestamptz(3)

  owner OrganizerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  event Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([eventId])
  @@map("media_uploads")
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
  REFUNDED

  @@map("order_status")
}

/// Purchases (docs/DATA_MODEL.md#orders). A PENDING order holds its tickets in
/// `ticket_types.reserved` until `expiresAt` (ADR-0007). One pending order per buyer and
/// event (a partial unique index), the timestamps of each status and the total's range
/// are in the migration.
model Order {
  id                    String      @id @db.Uuid
  publicCode            String      @unique @map("public_code")
  buyerId               String      @map("buyer_id") @db.Uuid
  eventId               String      @map("event_id") @db.Uuid
  status                OrderStatus @default(PENDING)
  totalCents            Int         @map("total_cents")
  currency              String      @default("BRL") @db.Char(3)
  expiresAt             DateTime    @map("expires_at") @db.Timestamptz(3)
  extensionCount        Int         @default(0) @map("extension_count") @db.SmallInt
  idempotencyKey        String      @map("idempotency_key")
  /// SHA-256 of the normalized request body.
  requestHash           Bytes       @map("request_hash")
  stripePaymentIntentId String?     @unique @map("stripe_payment_intent_id")
  /// Copies taken at purchase time, for the receipt. Personal data.
  buyerName             String      @map("buyer_name")
  buyerEmail            String      @map("buyer_email") @db.Citext
  createdAt             DateTime    @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  paidAt                DateTime?   @map("paid_at") @db.Timestamptz(3)
  expiredAt             DateTime?   @map("expired_at") @db.Timestamptz(3)
  canceledAt            DateTime?   @map("canceled_at") @db.Timestamptz(3)
  refundedAt            DateTime?   @map("refunded_at") @db.Timestamptz(3)

  buyer   User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  event   Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items   OrderItem[]
  tickets Ticket[]

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, createdAt(sort: Desc)])
  @@index([eventId, status])
  @@map("orders")
}

/// Stripe events already applied (docs/DATA_MODEL.md#processed_webhook_events). Inserted in
/// the transaction of the event's effect, so a redelivery changes nothing. No payload.
model ProcessedWebhookEvent {
  /// Stripe's event id (`evt_...`).
  id          String   @id
  type        String
  processedAt DateTime @map("processed_at") @db.Timestamptz(3)

  @@index([processedAt])
  @@map("processed_webhook_events")
}

/// The lines of an order (docs/DATA_MODEL.md#order_items), one per ticket type.
model OrderItem {
  id             String @id @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  ticketTypeId   String @map("ticket_type_id") @db.Uuid
  quantity       Int
  /// Copy of the price when the tickets were reserved.
  unitPriceCents Int    @map("unit_price_cents")

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  @@unique([orderId, ticketTypeId])
  @@index([ticketTypeId])
  @@map("order_items")
}

enum TicketStatus {
  VALID
  USED
  CANCELED

  @@map("ticket_status")
}

/// One per unit of a paid order (V5, ADR-0008). A trigger refuses a ticket for an order
/// that is not PAID or that does not match its order line.
model Ticket {
  id           String       @id @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  orderItemId  String       @map("order_item_id") @db.Uuid
  eventId      String       @map("event_id") @db.Uuid
  ticketTypeId String       @map("ticket_type_id") @db.Uuid
  /// VIRA-XXXX-XXXX, random: a reference for support and manual check-in.
  code         String       @unique
  holderName   String       @map("holder_name")
  status       TicketStatus @default(VALID)
  /// 16 random bytes inside the signed QR token.
  qrNonce      Bytes        @map("qr_nonce")
  usedAt       DateTime?    @map("used_at") @db.Timestamptz(3)
  checkedInBy  String?      @map("checked_in_by") @db.Uuid
  issuedAt     DateTime     @map("issued_at") @db.Timestamptz(3)
  canceledAt   DateTime?    @map("canceled_at") @db.Timestamptz(3)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  operator   User?      @relation(fields: [checkedInBy], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderItemId])
  @@index([eventId, status])
  @@index([ticketTypeId])
  @@index([checkedInBy])
  @@map("tickets")
}
