// Vira database schema. Reference design: docs/DATA_MODEL.md.
// Invariants Prisma cannot express (CHECK constraints, partial indexes, triggers,
// extensions) live as SQL in the migrations (ADR-0004).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Append-only record of sensitive actions (docs/DATA_MODEL.md#audit_logs).
/// UPDATE, DELETE and TRUNCATE are rejected by a trigger; see the migration.
model AuditLog {
  id         String   @id @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  /// Pseudonymous: stays valid after the user is anonymized. NULL for the system.
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  requestId  String?  @map("request_id")
  /// Validated per action; never holds personal data.
  metadata   Json     @default("{}") @db.JsonB

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

/// Transactional outbox: side effects (queue jobs) are recorded in the same
/// transaction as the state change that causes them, then dispatched afterwards
/// (docs/ARCHITECTURE.md#6-mensageria-e-jobs).
model OutboxMessage {
  id           String    @id @db.Uuid
  /// "<area>.<event>", e.g. "orders.paid"; each type routes to one queue.
  type         String
  /// Identifiers only, never personal data.
  payload      Json      @db.JsonB
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  /// Earliest time of the next dispatch attempt (exponential backoff on failure).
  availableAt  DateTime  @map("available_at") @db.Timestamptz(3)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")

  @@index([dispatchedAt, availableAt, createdAt])
  @@map("outbox_messages")
}

enum Role {
  BUYER
  ORGANIZER
  ADMIN

  @@map("role")
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("token_purpose")
}

/// Accounts (docs/DATA_MODEL.md#users). Personal data: email, name and password_hash.
model User {
  id               String    @id @db.Uuid
  /// Normalized (trimmed, lower case); `citext` makes the unique index case-insensitive.
  email            String    @unique @db.Citext
  name             String
  /// argon2id PHC string; NULL for accounts that only use social login.
  passwordHash     String?   @map("password_hash")
  /// Never taken from a request body: new accounts are BUYER.
  role             Role      @default(BUYER)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Consecutive failed password logins; reset by a successful login.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  /// While in the future, password logins are refused (progressive lockout).
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  anonymizedAt     DateTime? @map("anonymized_at") @db.Timestamptz(3)

  verificationTokens VerificationToken[]

  @@map("users")
}

/// Single-use tokens for e-mail verification and password reset
/// (docs/DATA_MODEL.md#verification_tokens). Only the SHA-256 hash is stored:
/// the token itself exists only in the e-mail that carries it.
model VerificationToken {
  id        String       @id @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash Bytes        @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}
