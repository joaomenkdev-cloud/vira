# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Origin of the web app allowed by CORS (exact match).
WEB_ORIGIN=http://localhost:3001

# Number of reverse proxies in front of the API (0 locally, 1 on Render).
TRUST_PROXY_HOPS=0

# OpenAPI UI at /docs. Defaults to enabled outside production.
# API_DOCS_ENABLED=true
