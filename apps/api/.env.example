# Copy to .env for local development. Never commit .env.
# The values below match docker-compose.yml (local-only credentials).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Origin of the web app allowed by CORS (exact match).
WEB_ORIGIN=http://localhost:3001

# Number of reverse proxies in front of the API (0 locally, 1 on Render).
TRUST_PROXY_HOPS=0

# OpenAPI UI at /docs. Defaults to enabled outside production.
# API_DOCS_ENABLED=true

# PostgreSQL 16. Production requires sslmode=require (or verify-ca/verify-full).
DATABASE_URL=postgresql://vira:vira_local@127.0.0.1:5432/vira

# Redis. Production requires rediss:// (TLS).
REDIS_URL=redis://127.0.0.1:6379

# Where the background consumers run. "separate" (default) runs them in the worker
# process (`pnpm --filter @vira/api start:worker`); "embedded" runs them inside the API
# process, for hosting plans without a background worker (ADR-0011).
# WORKER_MODE=separate
# How often the outbox is checked for messages to dispatch to the queues.
# OUTBOX_POLL_INTERVAL_MS=5000

# SMTP for transactional e-mail: Mailpit locally (UI at http://localhost:8025), Resend in
# production, where the URL must use smtps:// (or set requireTLS=true) and MAIL_FROM is required.
SMTP_URL=smtp://127.0.0.1:1025
# MAIL_FROM="Vira <no-reply@vira.localhost>"

# Signing keys for the session (JWT, 10 min) and CSRF tokens (ADR-0005). At least 256 bits
# each and different from each other: generate with `openssl rand -base64 32`. The values
# below are for local development only; the API refuses to start with one key for both.
JWT_SECRET=local-only-jwt-key-replace-me-0000000000000000
CSRF_SECRET=local-only-csrf-key-replace-me-000000000000000

# Social login (OAuth 2.0 with PKCE, ADR-0005). Each provider is on only when both of its
# variables are set; otherwise its routes answer 404. Register this callback URL with the
# provider (the browser reaches the API through the web's /api/v1 proxy):
#   <WEB_ORIGIN>/api/v1/auth/oauth/google/callback  (Google Cloud console, "Web application")
#   <WEB_ORIGIN>/api/v1/auth/oauth/github/callback  (GitHub, Settings > Developer settings > OAuth Apps)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Leaked-password check on sign-up, reset and password change (ADR-0005): only the first
# five characters of the password's SHA-1 leave the server (k-anonymity). On by default;
# if the service does not answer, the password is accepted and a warning is logged.
# PWNED_PASSWORDS_ENABLED=true
# PWNED_PASSWORDS_URL=https://api.pwnedpasswords.com

# Object storage for the event pictures, S3-compatible (ADR-0011, ADR-0012): SeaweedFS
# locally, Cloudflare R2 in production (https://<account>.r2.cloudflarestorage.com, region
# "auto", an R2 API token with read and write on the bucket only). The bucket is private.
# Browsers send files straight to it through pre-signed URLs, so the endpoint must be an
# address they reach, and the bucket needs CORS for WEB_ORIGIN: `pnpm --filter @vira/api
# storage:setup` creates the bucket (if missing) and sets the CORS rule.
S3_ENDPOINT=http://127.0.0.1:8333
# S3_REGION=auto
S3_BUCKET=vira-events
S3_ACCESS_KEY_ID=vira-local
S3_SECRET_ACCESS_KEY=vira-local-secret

# Payments with Stripe, in test mode only (ADR-0006): the API refuses to start with live
# keys (sk_live_, pk_live_, rk_live_). Take the test keys from the Stripe dashboard
# (Developers > API keys, "Test mode"). Both or neither; without them (development, tests)
# starting a payment answers 503. Required in production.
# PAYMENTS_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# The signing secret of the webhook endpoint (whsec_...). Without it the webhook answers
# 503. Required in production. Locally, the Stripe CLI prints one:
#   stripe listen --forward-to localhost:3000/api/v1/payments/stripe/webhook
#   stripe trigger payment_intent.succeeded   # (an event without an order: logged, ignored)
# With the checkout (V6), paying a test order with card 4242 4242 4242 4242 makes it PAID.
# STRIPE_WEBHOOK_SECRET=whsec_...
