    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vira/config": "workspace:^",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.29",
