# Copy to .env.local for local development. Never commit .env.local.

# Origin of the API that /api/v1/* is proxied to. Read when the app is built, so
# set it in the build environment. Defaults to the local API outside deployments;
# on Vercel it is required and must be https. Origin only: no path, query or credentials.
# API_ORIGIN=http://127.0.0.1:3000
