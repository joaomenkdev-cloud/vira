# Copy to .env.local for local development. Never commit .env.local.

# Origin of the API that /api/v1/* is proxied to. Read when the app is built, so
# set it in the build environment. Defaults to the local API outside deployments;
# on Vercel it is required and must be https. Origin only: no path, query or credentials.
# API_ORIGIN=http://127.0.0.1:3000

# Origin of the object storage the event photos come from (the signed addresses the API
# hands out). Only this origin may feed the image optimizer. Read when the app is built.
# Defaults to the local SeaweedFS outside deployments; on Vercel it is required and must
# be https (Cloudflare R2: https://<account>.r2.cloudflarestorage.com).
# STORAGE_ORIGIN=http://127.0.0.1:8333

# Public address of the site, for canonical and Open Graph links. On Vercel it falls
# back to the production domain Vercel provides.
# SITE_URL=http://localhost:3001
# Social logins offered on /entrar, comma separated: google, github. List only the ones
# whose credentials are set in the API (it answers 404 for the others). Empty: none.
# VIRA_OAUTH_PROVIDERS=google,github
