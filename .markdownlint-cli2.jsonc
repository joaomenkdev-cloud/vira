{
  "config": {
    "default": true,
    // Long lines are fine in prose and tables.
    "MD013": false,
    // Inline HTML is used for README badges and image placeholders.
    "MD033": { "allowed_elements": ["a", "h1", "p", "img", "br", "sub", "details", "summary"] },
    // Allow repeated headings in sibling sections (e.g. "Desktop" / "Mobile").
    "MD024": { "siblings_only": true },
    "MD041": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    // Kept verbatim as provided by the product owner.
    "docs/DESIGN_BRIEF.md",
    "CODE_OF_CONDUCT.md"
  ]
}
